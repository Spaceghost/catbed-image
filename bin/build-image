#!/bin/sh
# build-image: build the catbed installer ISO on this host (fedora) in a
# rootless podman container, and the rootfs tarball and qcow2 VM image built
# from the same locked closure. Private inputs and outputs live outside the
# repository, under $CATBED_PRIVATE (default ~/.local/share/catbed-image):
#
#   inputs/files.fossil   Fossil snapshot of ~/.files (copied from catbed)
#   keys/                 image signing key, generated on first build
#   cache/                exported closure, repo, mkimage work
#   out/                  images, .sha256 and manifests
#
# usage: build-image check | plan | iso | rootfs | publish [iso|rootfs|vm] | shell
set -eu

REPO=$(cd "$(dirname "$0")/.." && pwd)
PRIVATE=${CATBED_PRIVATE:-$HOME/.local/share/catbed-image}
IMAGE=localhost/catbed-builder:latest

die() { printf 'build-image: %s\n' "$*" >&2; exit 1; }

builder() {
    podman build --quiet -t "$IMAGE" -f "$REPO/builder/Containerfile" "$REPO/builder" >/dev/null
}

container() {
    mkdir -p "$PRIVATE/inputs" "$PRIVATE/keys" "$PRIVATE/cache" "$PRIVATE/out"
    chmod 700 "$PRIVATE" "$PRIVATE/keys"
    podman run --rm "$@"
}

mounts() {
    printf '%s\n' \
        -v "$REPO:/src:ro,z" \
        -v "$PRIVATE/inputs:/inputs:ro,z" \
        -v "$PRIVATE/keys:/keys:z" \
        -v "$PRIVATE/cache:/cache:z" \
        -v "$PRIVATE/out:/out:z"
}

case ${1:-} in
    check)
        builder
        container -v "$REPO:/src:ro,z" "$IMAGE" sh -c '
            cd /src && cue vet ./... && cue export . -e render.env --out text >/dev/null &&
            shellcheck -s sh -x -P SCRIPTDIR installer/catbed-install installer/catbed-firstboot \
                installer/catbed-common.sh builder/prepare.sh builder/build-iso.sh \
                builder/build-rootfs.sh bin/build-image mkimage/genapkovl-catbed.sh &&
            shellcheck -s sh -e SC2034,SC2154,SC2046,SC3043,SC2086,SC2155,SC2153,SC2016 mkimage/mkimg.catbed.sh &&
            python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" builder/export-packages.py && echo check: ok'
        ;;
    plan)
        builder
        container -v "$REPO:/src:ro,z" "$IMAGE" sh -c '
            cd /src && cue export . -e render.env --out text'
        ;;
    iso)
        [ -r "$PRIVATE/inputs/files.fossil" ] ||
            die "no snapshot at $PRIVATE/inputs/files.fossil (see README: Inputs)"
        builder
        # shellcheck disable=SC2046
        container $(mounts) "$IMAGE" sh /src/builder/build-iso.sh
        ;;
    rootfs)
        [ -r "$PRIVATE/inputs/files.fossil" ] ||
            die "no snapshot at $PRIVATE/inputs/files.fossil (see README: Inputs)"
        builder
        # --privileged under rootless podman stays inside the user namespace;
        # it lets the build mount proc and bind /dev into the new root.
        # shellcheck disable=SC2046
        container --privileged $(mounts) "$IMAGE" sh /src/builder/build-rootfs.sh
        ;;
    publish)
        # Encrypt one built image to the recovery identity (the same SSH key
        # RECOVERY.md decrypts with), split it under the 2 GiB release-asset
        # limit and attach it to a release in the PRIVATE artifact repo.
        kind=${2:-iso}
        case $kind in
            iso) file=alpine-catbed-edge-x86_64.iso; manifest=alpine-catbed-edge-x86_64.manifest.json ;;
            rootfs) file=catbed-rootfs-x86_64.tar.zst; manifest=catbed-rootfs-x86_64.manifest.json ;;
            vm) file=catbed-vm-x86_64.qcow2; manifest=catbed-vm-x86_64.manifest.json ;;
            *) die "publish what? iso, rootfs or vm" ;;
        esac
        target=${CATBED_PRIVATE_REPO:-Spaceghost/catbed-image-private}
        [ "$(gh repo view "$target" --json visibility -q .visibility)" = PRIVATE ] ||
            die "$target is not private; refusing to publish"
        [ -r "$PRIVATE/keys/recipient-catbed-jack.pub" ] ||
            die "no recipient key at $PRIVATE/keys/recipient-catbed-jack.pub"
        [ -r "$PRIVATE/out/$file" ] || die "no $file; build it first"
        sum=$(cut -c1-8 "$PRIVATE/out/$file.sha256")
        tag=catbed-$kind-$(date -u +%Y%m%d)-$sum
        stage=$PRIVATE/publish/$tag
        rm -rf "$stage"; mkdir -p "$stage"
        builder
        # shellcheck disable=SC2016 # expanded inside the container
        container -v "$PRIVATE:/p:z" "$IMAGE" sh -euc '
            apk add -q --no-cache age >/dev/null
            cd "/p/publish/$1"
            age -R /p/keys/recipient-catbed-jack.pub -o image.age "/p/out/$2"
            split -b 1900m -a 2 image.age "$2.age.part-"
            rm image.age
            cp "/p/out/$2.sha256" "/p/out/$3" .
            sha256sum "$2".age.part-* > SHA256SUMS
        ' sh "$tag" "$file" "$manifest"
        gh release create "$tag" --repo "$target" \
            --title "catbed $kind $tag" \
            --notes "Age-encrypted to the catbed recovery identity. Reassemble: cat $file.age.part-* > image.age; age -d -i ~/.ssh/id_ed25519 -o $file image.age; sha256sum -c $file.sha256" \
            "$stage"/*
        printf 'published %s to %s\n' "$tag" "$target"
        ;;
    shell)
        builder
        # shellcheck disable=SC2046
        container -it $(mounts) "$IMAGE" sh
        ;;
    *)
        sed -n '2,13p' "$0"
        exit 2
        ;;
esac
